#!/bin/sh
# Git credential helper: serves the fine-grained GitHub token from the
# read-only Compose secret, for https://github.com only. Never stores it.
set -eu
[ "${1:-}" = "get" ] || exit 0
host=""
protocol=""
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  case "$key" in
    host) host=$value ;;
    protocol) protocol=$value ;;
  esac
done
[ "$protocol" = "https" ] && [ "$host" = "github.com" ] || exit 0
[ -s /run/secrets/github_token ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat /run/secrets/github_token)"
